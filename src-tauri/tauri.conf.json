{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hello Gitty",
  "version": "0.1.1",
  "identifier": "com.hellogitty.desktop",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "node scripts/dev_server.mjs 1421 ./src",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hello Gitty",
        "width": 760,
        "height": 680,
        "minWidth": 580,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5QTM5OEJEMENFQTVCNUMKUldSY1crb012WmlqT1E5WUwrR2tVWFV5M0RVQW1yYjVsUzZvN21YVGJkV2ltYnpZVldXaGdSWHMK",
      "endpoints": [
        "https://github.com/Bavoch/hello-gitty/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "Bavoch",
    "homepage": "https://github.com/Bavoch/hello-gitty",
    "copyright": "Copyright © Bavoch",
    "license": "MIT",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
